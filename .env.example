# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-api-key,your-second-api-key
# Any LiteLLM model name your keys can use (check the provider's current model list).
LLM_MODEL=gemini/gemini-2.5-flash-lite
# SQLite file location. Mount a volume at /data so history survives restarts.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (add your deployed frontend URL).
ALLOWED_ORIGINS=http://localhost:3000
# Enables the X-Simulate-Failure test header. Must be true on the deployed backend.
ENABLE_FAILURE_SIMULATION=true
# Frontend only: backend URL baked into the build.
VITE_API_URL=http://localhost:8000
# Optional
# DEFAULT_SYSTEM_PROMPT=You are a helpful assistant. Keep answers clear and concise.
# LLM_TIMEOUT_SECONDS=30
